# Copy to web/.env.local (gitignored).
#
# WARNING: every VITE_* variable is compiled into the PUBLIC JavaScript bundle and is readable by
# anyone. Only put public identifiers here (OAuth client IDs, app keys, extension ID).
# NEVER put a client secret, API secret, or token in a VITE_* variable.
VITE_EXTENSION_ID=
VITE_EBAY_CLIENT_ID=
VITE_EBAY_RU_NAME=
VITE_EBAY_ENV=production
VITE_ETSY_CLIENT_ID=
VITE_TIKTOK_APP_KEY=
VITE_ALIEXPRESS_APP_KEY=
