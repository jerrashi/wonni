// Secrets.xcconfig.example
// Checked-in placeholder — copy to Secrets.xcconfig (gitignored) for a real
// local build, or let CI copy it verbatim (see .github/workflows/test.yml).
// These are compile-time build-setting substitutions, not runtime secrets:
// CI only needs the file to exist with these keys defined to compile: the
// real values are never read outside actual OAuth flows against eBay/Etsy.

/// ebay
EBAY_CLIENT_KEY = ci-placeholder
EBAY_CLIENT_ID = ci-placeholder
EBAY_RUNAME = ci-placeholder

/// etsy
ETSY_CLIENT_ID = ci-placeholder
