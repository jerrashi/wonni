#!/bin/sh
# wonni pre-commit — keep the backend contract artifacts + tests honest.
# Enable once:  git config core.hooksPath githooks
#
# Runs only when something under functions/ is staged. Skip with:  git commit --no-verify

if git diff --cached --name-only | grep -q '^functions/'; then
  echo "· pre-commit: functions/ changed — running npm run verify"
  ( cd functions && npm run verify ) || {
    echo
    echo "✗ pre-commit: 'npm run verify' failed. Fix, or commit with --no-verify."
    exit 1
  }
fi

# Secret scan — blocks a commit that stages API keys / tokens / private keys.
# Install once:  brew install gitleaks     (skipped with a notice if absent)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner || {
    echo
    echo "✗ pre-commit: gitleaks found a possible secret in the staged changes."
    echo "  Remove it (and rotate it if it was ever pushed), or bypass with --no-verify."
    exit 1
  }
else
  echo "· pre-commit: gitleaks not installed — secret scan skipped (brew install gitleaks)"
fi
