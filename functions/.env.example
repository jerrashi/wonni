# Copy to functions/.env.<firebase-project-id> (e.g. .env.wonni-app) — that file is gitignored.
#
# ONLY non-secret configuration belongs here (read via defineString()).
# SECRETS (API keys, client secrets, tokens) must NEVER go in a .env file — store them in
# Secret Manager:   firebase functions:secrets:set <NAME> --project wonni-app
# and reference them with `secrets: ["<NAME>"]` on the function that needs them.
EBAY_RU_NAME=
EBAY_ENV=production
